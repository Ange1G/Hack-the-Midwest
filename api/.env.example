APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agent_platform

# Comma-separated browser origins allowed to call this API (CORS). In development and
# test, defaults include the dashboard dev server (localhost:3000) when unset.
# Required in production when the frontend is on a different origin than the API.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Fernet key that encrypts connector credentials (xApiKey, authorizationHeader).
# Leave empty to refuse credentials. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Runner image and how that container reaches this API.
EXECUTION_RUNNER_IMAGE=agent-platform-runner:local
EXECUTION_CALLBACK_BASE_URL=http://host.docker.internal:8000
EXECUTION_TIMEOUT_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=1
DOCKER_ENABLED=true

# Platform-owned OpenAI key injected into the runner container. Never commit a real key.
# The worker fails executions with llm_unconfigured if this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_ACTIVE_EXECUTIONS_PER_OWNER=5

# Optional: absolute path to a PEM CA bundle on the worker host. When set, the
# worker mounts it read-only into every execution container and sets SSL_CERT_FILE
# so Python/httpx uses it. Required on hosts with TLS inspection (Zscaler, Netskope,
# corp PKI). Leave empty in standard production environments.
# Example (macOS with corporate proxy):
#   security find-certificate -a -p \
#     /System/Library/Keychains/SystemRootCertificates.keychain \
#     /Library/Keychains/System.keychain > ~/mac-ca.pem
#   EXECUTION_SSL_CA_BUNDLE=/Users/yourname/mac-ca.pem
EXECUTION_SSL_CA_BUNDLE=

# Provisioned database connectors (Docker must be running where agent runs start).
# Unset: databases publish a random port on 127.0.0.1 (local development).
# Set: databases join this Docker network (created --internal if missing) instead.
# DATABASE_PROVISIONER_NETWORK=constitution-agents
# Seconds to wait for a provisioned database to accept connections.
# DATABASE_PROVISIONER_READY_TIMEOUT=90
