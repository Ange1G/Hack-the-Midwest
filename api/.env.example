APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform

# Fernet key that encrypts agent credentials (xApiKey, authorizationHeader).
# Leave empty to refuse credentials. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
